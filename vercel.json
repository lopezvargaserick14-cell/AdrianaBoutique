{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/markdown"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/categoria/(.*)", "destination": "/index.html" },
    { "source": "/producto/(.*)", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/api/404" }
  ]
}
